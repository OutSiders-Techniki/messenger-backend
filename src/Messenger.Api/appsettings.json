{
  "Session": {
    "CookieName": "messenger_session",
    "Secure": true,
    "SameSite": "Strict",
    "LifetimeHours": 168
  },
  "AttachmentStorage": {
    "RootPath": "storage/attachments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
